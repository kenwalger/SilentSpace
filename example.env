# SilentSpace Guardian — Environment Variable Reference
#
# Copy this file to .env and adjust values for your local setup.
# Commit changes to this file. Never commit .env directly.
#
# Note: the variables below are planned but not yet read by the Python scripts.
# Paths are currently resolved relative to the project root automatically.

# ── COBOL Engine ──────────────────────────────────────────────────────────────

# Path to the compiled COBOL entropy engine binary.
# Defaults to cobol/entropy_engine (or cobol/entropy_engine.exe on Windows).
# Planned: override if you maintain a shared binary outside the project root.
# COBOL_BINARY_PATH=

# ── Output ────────────────────────────────────────────────────────────────────

# Directory where Markdown audit reports are written.
# Defaults to reports/ relative to the project root.
# Planned: override to write reports to a different location.
# REPORTS_DIR=

# ── Debug ─────────────────────────────────────────────────────────────────────

# Planned: set to true to enable verbose output (raw COBOL stdout, parameter
# dump, intermediate classification state).
# GUARDIAN_DEBUG=false
