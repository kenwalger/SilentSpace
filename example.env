# SilentSpace Guardian — Environment Variable Reference
#
# Copy this file to .env and adjust values for your local setup.
# Commit changes to this file. Never commit .env directly.
# All variables are optional. Defaults are noted below.

# ── COBOL Engine ──────────────────────────────────────────────────────────────

# Path to the compiled COBOL entropy engine binary.
# Defaults to cobol/entropy_engine (or cobol/entropy_engine.exe on Windows).
# Override if you maintain a shared binary outside the project root,
# or if your GnuCOBOL installation produces a non-standard output path.
# COBOL_BINARY_PATH=

# ── Output ────────────────────────────────────────────────────────────────────

# Directory where Markdown audit reports are written.
# Defaults to reports/ relative to the project root.
# REPORTS_DIR=

# ── Debug ─────────────────────────────────────────────────────────────────────

# Set to true to enable verbose output: raw COBOL stdout, parameter dump,
# and intermediate classification state. Useful when the entropy engine
# returns something unexpected, which it should not, but here we are.
# GUARDIAN_DEBUG=false
